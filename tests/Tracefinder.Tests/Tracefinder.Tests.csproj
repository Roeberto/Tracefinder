<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <!-- Tylko foldery bez zależności od Godota, dzięki czemu testy nie potrzebują silnika -->
  <ItemGroup>
    <Compile Include="../../scripts/Character/**/*.cs" LinkBase="Linked/Character" />
    <Compile Include="../../scripts/Gameplay/**/*.cs" LinkBase="Linked/Gameplay" />
    <Compile Include="../../scripts/Items/**/*.cs" LinkBase="Linked/Items" />
    <Compile Include="../../scripts/Combat/**/*.cs" LinkBase="Linked/Combat" />
    <Compile Include="../../scripts/World/**/*.cs" LinkBase="Linked/World" />
  </ItemGroup>
</Project>
